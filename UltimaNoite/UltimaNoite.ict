  - type: folder
    uid: bn4JMkNGM2J25c
    colorClass: act
    icon: template
    name: Template
    lastmod: 1795040328349
    entries:
      - type: template
        baseClass: AnimatedSprite
        name: Jogador
        depth: 0
        texture: G365f6kHR8KwP8
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: |

              if (rooms.current.paused) {
                  this.hspeed = 0;
                  this.vspeed = 0;
                  return;
              }

              if (this.vida <= 0) {
                  this.hspeed = 0;
                  this.vspeed = 0;

                  if (this.animando) {
                      this.gotoAndStop(0);
                      this.animando = false;
                  }

                  return;
              }

              const dx = actions.MoveXesq.value +
                         actions.MoveXdir.value;

              const dy = actions.MoveYcima.value +
                         actions.MoveYbaixo.value;

              const distancia = Math.hypot(dx, dy);

              if (distancia > 0) {
                  this.hspeed = dx / distancia * this.velocidade;
                  this.vspeed = dy / distancia * this.velocidade;
              } else {
                  this.hspeed = 0;
                  this.vspeed = 0;
              }

              this.moveSmart('CenarioSolido');

              this.x = Math.max(26, Math.min(1254, this.x));
              this.y = Math.max(26, Math.min(694, this.y));

              const angulo = u.pointDirection(
                  this.x,
                  this.y,
                  pointer.x,
                  pointer.y
              );

              this.angle = angulo + 90;

              if (actions.Atirar.pressed) {
                  const tiro = templates.copy(
                      'Projetil',
                      this.x,
                      this.y
                  );

                  sounds.play('som_tiro', {
                      volume: 0.05
                  });

                  tiro.dano = this.dano;
                  tiro.speed = this.velocidadeProjetil;
                  tiro.direction = angulo;
                  tiro.angle = angulo;
              }

              const andando = Math.hypot(
                  this.hspeed,
                  this.vspeed
              ) > 1;

              if (andando) {
                  if (!this.animando) {
                      this.gotoAndPlay(0);
                      this.animando = true;
                  }
              } else if (this.animando) {
                  this.gotoAndStop(0);
                  this.animando = false;
              }

              const agoraVisual = Date.now();

              if (agoraVisual < this.piscarAte) {
                  const fase = Math.floor(agoraVisual / 70) % 2;
                  this.tint = fase === 0 ? 0xFF5555 : 0xFFFFFF;
              } else {
                  this.tint = 0xFFFFFF;
              }
            arguments: {}
          - eventKey: OnCreate
            code: |

              this.vida = 100;
              this.vidaMaxima = 100;
              this.velocidade = 240;
              this.dano = 20;
              this.velocidadeProjetil = 500;
              this.campoVisao = 0;

              this.moedas = 0;
              this.pontos = 0;
              this.gameOverRegistrado = false;

              this.hspeed = 0;
              this.vspeed = 0;

              this.scale.set(0.09);
              this.animationSpeed = 0.12;
              this.loop = true;
              this.gotoAndStop(0);

              this.animando = false;
              this.angle = 0;
              this.tint = 0xFFFFFF;

              this.piscarAte = 0;
              this.duracaoPiscar = 180;
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1795397493726
        uid: 489p9JKMb6NGWT
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: Text
        name: TelaMenu
        depth: 0
        texture: -1
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |

              this.text = '';

              this.painel = new PIXI.Container();
              this.addChild(this.painel);

              this.criarTexto = (conteudo, tamanho, cor, x, y) => {
                  const txt = new PIXI.Text(conteudo, {
                      fontFamily: 'Arial',
                      fontSize: tamanho,
                      fontWeight: 'bold',
                      fill: cor,
                      align: 'center'
                  });

                  txt.anchor.set(0.5);
                  txt.x = x;
                  txt.y = y;

                  this.painel.addChild(txt);
                  return txt;
              };

              this.criarBotao = (nome, x, y, largura, acao) => {
                  const botao = new PIXI.Container();

                  botao.x = x;
                  botao.y = y;

                  const fundo = new PIXI.Graphics();
                  fundo.beginFill(0x293548);
                  fundo.lineStyle(2, 0x536985);
                  fundo.drawRoundedRect(0, 0, largura, 58, 10);
                  fundo.endFill();

                  botao.addChild(fundo);

                  const texto = new PIXI.Text(nome, {
                      fontFamily: 'Arial',
                      fontSize: 22,
                      fontWeight: 'bold',
                      fill: 0xFFFFFF
                  });

                  texto.anchor.set(0.5);
                  texto.x = largura / 2;
                  texto.y = 29;

                  botao.addChild(texto);

                  botao.eventMode = 'static';
                  botao.cursor = 'pointer';
                  botao.hitArea = new PIXI.Rectangle(
                      0, 0, largura, 58
                  );

                  botao.on('pointertap', acao);

                  this.painel.addChild(botao);
                  return botao;
              };

              this.titulo = this.criarTexto(
                  'ULTIMA NOITE',
                  58,
                  0xFFFFFF,
                  640,
                  160
              );

              this.subtitulo = this.criarTexto(
                  'SOBREVIVA A NOITE',
                  20,
                  0xE9BD6E,
                  640,
                  215
              );

              this.conteudo = this.criarTexto(
                  '',
                  22,
                  0xFFFFFF,
                  640,
                  335
              );

              this.conteudo.style.wordWrap = true;
              this.conteudo.style.wordWrapWidth = 850;

              this.btnJogar = this.criarBotao(
                  'JOGAR',
                  490, 290, 300,
                  () => {
                      try {
                          rooms.switch('rm_jogo');
                      } catch (erro) {
                          console.error('Erro ao abrir o jogo:', erro);
                      }
                  }
              );

              this.btnComo = this.criarBotao(
                  'COMO JOGAR',
                  490, 365, 300,
                  () => this.mostrarPagina('ajuda')
              );

              this.btnCreditos = this.criarBotao(
                  'CREDITOS',
                  490, 440, 300,
                  () => this.mostrarPagina('creditos')
              );

              this.btnVoltar = this.criarBotao(
                  'VOLTAR',
                  490, 520, 300,
                  () => this.mostrarPagina('inicio')
              );

              this.mostrarPagina = pagina => {
                  const inicio = pagina === 'inicio';

                  this.btnJogar.visible = inicio;
                  this.btnComo.visible = inicio;
                  this.btnCreditos.visible = inicio;
                  this.btnVoltar.visible = !inicio;

                  this.conteudo.visible = !inicio;

                  if (pagina === 'ajuda') {
                      this.conteudo.text =
                          'WASD OU SETAS - MOVIMENTAR\n' +
                          'MOUSE - MIRAR\n' +
                          'CLIQUE ESQUERDO - ATIRAR\n' +
                          'P OU ESC - PAUSAR\n' +
                          '1, 2 OU 3 - COMPRAR MELHORIA\n' +
                          '0 - PULAR A LOJA\n\n' +
                          'ELIMINE ZUMBIS, COLETE MOEDAS\n' +
                          'E KITS MEDICOS PARA SOBREVIVER.';
                  }

                  if (pagina === 'creditos') {
                      this.conteudo.text =
                          '\n\nCREDITOS\n\n' +
                          'ULTIMA NOITE - 2026\n\n' +
                          'DESENVOLVIMENTO:\n' +
                          'Bernardo Dutra Aperibense Ottoni\n' +
                          'Bruno Oliveira de Souza\n' +
                          'Nicolas Reis Xavier Silva\n' +
                          'Alceu Vasconcellos Botelho dos Reis\n\n' +
                          'DESENVOLVIDO COM CT.JS 5.3.1';
                  }
              };

              this.mostrarPagina('inicio');
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1795397542707
        uid: Gh8jPp9J1L7mfq
        behaviors: []
        extendTypes: ''
        defaultText: ''
        textStyle: 2KWWMJk43hLqWJ
      - type: template
        baseClass: AnimatedSprite
        name: Obstaculo
        depth: 0
        texture: Pd8JThdqrm5LQq
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |

              this.visible = false;
              this.hspeed = 0;
              this.vspeed = 0;
            arguments: {}
            lib: core
        extends:
          cgroup: CenarioSolido
          'editor:myCollidingCGroups': []
        lastmod: 1795397482523
        uid: h961925Nwm5qNb
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: Text
        name: Hud
        depth: 1000
        texture: -1
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: |

              if (actions.Pausar && actions.Pausar.pressed) {
                  this.alternarPausa();
              }
            arguments: {}
          - eventKey: OnDraw
            code: |

              const jogador = (templates.list['Jogador'] || [])
                  .find(j => templates.valid(j));

              if (!jogador) {
                  this.textoVida.text = '';
                  this.textoInfo.text = '';

                  this.graficosVida.clear();
                  this.barrasZumbis.clear();

                  this.lojaContainer.visible = false;
                  return;
              }

              const gerenciador = (
                  templates.list['GerenciadorOndas'] || []
              ).find(g => templates.valid(g));

              if (
                  jogador.vida <= 0 &&
                  !jogador.gameOverRegistrado
              ) {
                  jogador.gameOverRegistrado = true;

                  const pontos = jogador.pontos;
                  const onda = gerenciador ? gerenciador.onda : 0;

                  let recorde = 0;

                  try {
                      recorde = Number(
                          localStorage.getItem(
                              'UltimaNoite_recorde'
                          ) || 0
                      );

                      if (pontos > recorde) {
                          recorde = pontos;

                          localStorage.setItem(
                              'UltimaNoite_recorde',
                              String(recorde)
                          );
                      }
                  } catch (erro) {
                      recorde = Math.max(recorde, pontos);
                      console.warn('Erro ao salvar recorde:', erro);
                  }

                  ct.ultimaNoiteResultado = {
                      pontos,
                      onda,
                      recorde
                  };

                  rooms.switch('rm_gameover');
                  return;
              }

              const zumbis = templates.list['Zumbi'] || [];

              const zumbisVivos = zumbis.filter(
                  z => templates.valid(z) &&
                       !z.kill &&
                       !z.morrendo &&
                       z.vida > 0
              );

              const inimigos = zumbisVivos.length;

              const vida = Math.max(
                  0,
                  Math.ceil(jogador.vida)
              );

              const vidaMaxima = Math.max(
                  1,
                  jogador.vidaMaxima
              );

              const percentualVida = Math.max(
                  0,
                  Math.min(1, vida / vidaMaxima)
              );

              const ondaAtual = gerenciador
                  ? gerenciador.onda
                  : 0;

              const ondaVinheta = Math.max(1, ondaAtual);
              const nivelVisao = Math.max(
                  0,
                  Number(jogador.campoVisao) || 0
              );

              this.spriteVinheta.x = jogador.x - this.x;
              this.spriteVinheta.y = jogador.y - this.y;

              if (
                  ondaVinheta !== this.ultimaOndaVinheta ||
                  nivelVisao !== this.ultimoNivelVisao
              ) {
                  this.atualizarVinheta(
                      ondaVinheta,
                      nivelVisao
                  );
              }

              this.textoVida.text =
                  'VIDA: ' + vida + '/' + vidaMaxima;

              this.graficosVida.clear();

              this.graficosVida.beginFill(0x542B35);
              this.graficosVida.drawRoundedRect(
                  5,
                  34,
                  250,
                  18,
                  6
              );
              this.graficosVida.endFill();

              if (percentualVida > 0) {
                  const cor = percentualVida <= 0.30
                      ? 0xF59E42
                      : 0xEF5365;

                  this.graficosVida.beginFill(cor);
                  this.graficosVida.drawRoundedRect(
                      5,
                      34,
                      250 * percentualVida,
                      18,
                      6
                  );
                  this.graficosVida.endFill();
              }

              this.textoInfo.text =
                  'PONTOS: ' + jogador.pontos +
                  '\nMOEDAS: ' + jogador.moedas +
                  '\nONDA: ' + ondaAtual +
                  '\nINIMIGOS: ' + inimigos;

              this.barrasZumbis.clear();

              for (const zumbi of zumbisVivos) {
                  const vidaMaxZumbi = Math.max(
                      1,
                      zumbi.vidaMaxima
                  );

                  const percentual = Math.max(
                      0,
                      Math.min(
                          1,
                          zumbi.vida / vidaMaxZumbi
                      )
                  );

                  const x = zumbi.x - this.x;

                  const y =
                      zumbi.y -
                      this.y -
                      this.deslocamentoBarraZumbi;

                  const largura = this.larguraBarraZumbi;
                  const altura = this.alturaBarraZumbi;

                  let cor = 0x72D46D;

                  if (percentual <= 0.30) {
                      cor = 0xEF5961;
                  } else if (percentual <= 0.60) {
                      cor = 0xEFBB4E;
                  }

                  this.barrasZumbis.beginFill(0x512B34);
                  this.barrasZumbis.drawRoundedRect(
                      x - largura / 2,
                      y,
                      largura,
                      altura,
                      3
                  );
                  this.barrasZumbis.endFill();

                  if (percentual > 0) {
                      this.barrasZumbis.beginFill(cor);

                      this.barrasZumbis.drawRoundedRect(
                          x - largura / 2,
                          y,
                          largura * percentual,
                          altura,
                          3
                      );

                      this.barrasZumbis.endFill();
                  }
              }

              const lojaAberta = Boolean(
                  gerenciador &&
                  gerenciador.estado === 'escolha'
              );

              this.lojaContainer.visible = lojaAberta;

              if (lojaAberta) {
                  this.fundoLoja.clear();

                  this.fundoLoja.beginFill(
                      0x080D17,
                      0.45
                  );

                  this.fundoLoja.drawRect(
                      -this.x,
                      -this.y,
                      1280,
                      720
                  );

                  this.fundoLoja.endFill();

                  this.tituloLoja.text =
                      'ONDA ' + ondaAtual +
                      ' CONCLUIDA!\nLOJA DE MELHORIAS';

                  this.saldoLoja.text =
                      'SALDO: ' +
                      jogador.moedas +
                      ' MOEDAS';

                  this.graficosLoja.clear();

                  const opcoes =
                      gerenciador.opcoesMelhoria || [];

                  for (let i = 0; i < 3; i++) {
                      const melhoria = opcoes[i];

                      if (!melhoria) {
                          this.cardsLoja[i].text = '';
                          continue;
                      }

                      const x = 235 + i * 260;
                      const y = 270;

                      const podeComprar =
                          jogador.moedas >= melhoria.preco;

                      const corFundo = podeComprar
                          ? 0x293143
                          : 0x353039;

                      const corBorda = podeComprar
                          ? 0xE6BE64
                          : 0x76505A;

                      this.graficosLoja.beginFill(corFundo);
                      this.graficosLoja.drawRoundedRect(
                          x,
                          y,
                          240,
                          180,
                          12
                      );
                      this.graficosLoja.endFill();

                      this.graficosLoja.lineStyle(
                          2,
                          corBorda
                      );

                      this.graficosLoja.drawRoundedRect(
                          x,
                          y,
                          240,
                          180,
                          12
                      );

                      this.graficosLoja.lineStyle(0);

                      const status = podeComprar
                          ? 'DISPONIVEL'
                          : 'SEM MOEDAS';

                      this.cardsLoja[i].text =
                          '[' + (i + 1) + ']' +
                          '\n\n' +
                          melhoria.nome +
                          '\n\n' +
                          melhoria.preco + ' MOEDAS' +
                          '\n' +
                          status;
                  }

                  this.instrucaoLoja.text =
                      'PRESSIONE 1, 2 OU 3 PARA COMPRAR' +
                      '\nPRESSIONE 0 PARA PULAR';
              }
            arguments: {}
            lib: core
          - eventKey: OnCreate
            code: |

              this.text = '';

              this.criarTexto = (
                  tamanho,
                  cor,
                  alinhamento = 'left'
              ) => {
                  const estilo = new PIXI.TextStyle({
                      fontFamily: 'Arial',
                      fontSize: tamanho,
                      fontWeight: 'bold',
                      fill: cor
                  });

                  estilo.align = alinhamento;

                  const texto = new PIXI.Text('', estilo);
                  this.addChild(texto);
                  return texto;
              };

              this.graficosVida = new PIXI.Graphics();
              this.addChild(this.graficosVida);

              this.textoVida = this.criarTexto(22, 0xFFFFFF);
              this.textoVida.x = 5;
              this.textoVida.y = 0;

              this.textoInfo = this.criarTexto(
                  20,
                  0xFFFFFF,
                  'right'
              );

              this.textoInfo.anchor.set(1, 0);
              this.textoInfo.x = 1050;
              this.textoInfo.y = 0;

              this.barrasZumbis = new PIXI.Graphics();
              this.addChild(this.barrasZumbis);

              this.lojaContainer = new PIXI.Container();
              this.addChild(this.lojaContainer);

              this.fundoLoja = new PIXI.Graphics();
              this.lojaContainer.addChild(this.fundoLoja);

              this.graficosLoja = new PIXI.Graphics();
              this.lojaContainer.addChild(this.graficosLoja);

              this.criarTextoLoja = (
                  tamanho,
                  cor,
                  largura = 220
              ) => {
                  const estilo = new PIXI.TextStyle({
                      fontFamily: 'Arial',
                      fontSize: tamanho,
                      fontWeight: 'bold',
                      fill: cor,
                      wordWrap: true,
                      wordWrapWidth: largura
                  });

                  estilo.align = 'center';

                  const texto = new PIXI.Text('', estilo);
                  texto.anchor.set(0.5);

                  this.lojaContainer.addChild(texto);
                  return texto;
              };

              this.tituloLoja = this.criarTextoLoja(
                  30, 0xFFFFFF, 800
              );

              this.tituloLoja.x = 615;
              this.tituloLoja.y = 155;

              this.saldoLoja = this.criarTextoLoja(
                  22, 0xFACC15, 600
              );

              this.saldoLoja.x = 615;
              this.saldoLoja.y = 225;

              this.cardsLoja = [];

              for (let i = 0; i < 3; i++) {
                  const texto = this.criarTextoLoja(
                      19,
                      0xFFFFFF,
                      215
                  );

                  texto.x = 355 + i * 260;
                  texto.y = 355;

                  this.cardsLoja.push(texto);
              }

              this.instrucaoLoja = this.criarTextoLoja(
                  19, 0xD1D5DB, 900
              );

              this.instrucaoLoja.x = 615;
              this.instrucaoLoja.y = 525;
              this.lojaContainer.visible = false;

              this.larguraBarraZumbi = 46;
              this.alturaBarraZumbi = 7;
              this.deslocamentoBarraZumbi = 43;

              rooms.current.paused = false;

              this.inicioPausa = 0;
              this.animacoesPausadas = [];
              this.transicaoPausaAtiva = false;

              this.telaPausa = new PIXI.Container();
              this.addChild(this.telaPausa);

              const fundoPausa = new PIXI.Graphics();

              fundoPausa.beginFill(0x080D17, 0.65);

              fundoPausa.drawRect(
                  -this.x,
                  -this.y,
                  1280,
                  720
              );

              fundoPausa.endFill();

              fundoPausa.eventMode = 'static';

              fundoPausa.hitArea = new PIXI.Rectangle(
                  -this.x,
                  -this.y,
                  1280,
                  720
              );

              this.telaPausa.addChild(fundoPausa);

              const sombraPausa = new PIXI.Graphics();

              sombraPausa.beginFill(0x000000, 0.45);
              sombraPausa.drawRoundedRect(
                  348, 153, 550, 440, 18
              );
              sombraPausa.endFill();

              this.telaPausa.addChild(sombraPausa);

              const painelPausa = new PIXI.Graphics();

              painelPausa.lineStyle(2, 0x536985);
              painelPausa.beginFill(0x171F2C, 0.98);
              painelPausa.drawRoundedRect(
                  340, 145, 550, 440, 18
              );
              painelPausa.endFill();

              this.telaPausa.addChild(painelPausa);

              const faixaPausa = new PIXI.Graphics();

              faixaPausa.beginFill(0xA8323E);
              faixaPausa.drawRoundedRect(
                  362, 163, 506, 5, 2
              );
              faixaPausa.endFill();

              this.telaPausa.addChild(faixaPausa);

              const detalhePausa = new PIXI.Graphics();

              detalhePausa.beginFill(0xA8323E);
              detalhePausa.drawRoundedRect(
                  340, 180, 4, 370, 2
              );
              detalhePausa.endFill();

              this.telaPausa.addChild(detalhePausa);

              const criarTextoPausa = (
                  conteudo,
                  tamanho,
                  cor,
                  x,
                  y
              ) => {
                  const txt = new PIXI.Text(conteudo, {
                      fontFamily: 'Arial',
                      fontSize: tamanho,
                      fontWeight: 'bold',
                      fill: cor,
                      align: 'center'
                  });

                  txt.anchor.set(0.5);
                  txt.x = x;
                  txt.y = y;

                  this.telaPausa.addChild(txt);
                  return txt;
              };

              this.textoProtocoloPausa = criarTextoPausa(
                  'PROTOCOLO DE SOBREVIVENCIA // PAUSADO',
                  12,
                  0xC45A63,
                  615,
                  190
              );

              this.textoTituloPausa = criarTextoPausa(
                  'JOGO PAUSADO',
                  42,
                  0xFFFFFF,
                  615,
                  230
              );

              this.textoDescricaoPausa = criarTextoPausa(
                  'SUA SOBREVIVENCIA ESTA EM ESPERA',
                  17,
                  0xB9C5D5,
                  615,
                  290
              );

              this.textoInstrucaoPausa = criarTextoPausa(
                  'PRESSIONE P OU ESC PARA CONTINUAR',
                  17,
                  0xAEB9CB,
                  615,
                  540
              );

              const criarBotaoPausa = (
                  nome,
                  y,
                  acao,
                  cor = 0x315F83
              ) => {
                  const botao = new PIXI.Container();

                  botao.x = 435;
                  botao.y = y;

                  const fundo = new PIXI.Graphics();

                  const desenharFundo = (corFundo, corBorda) => {
                      fundo.clear();
                      fundo.lineStyle(2, corBorda, 1);
                      fundo.beginFill(corFundo);
                      fundo.drawRoundedRect(
                          0, 0, 360, 58, 10
                      );
                      fundo.endFill();
                  };

                  desenharFundo(cor, 0x536985);
                  botao.addChild(fundo);

                  const txt = new PIXI.Text(nome, {
                      fontFamily: 'Arial',
                      fontSize: 21,
                      fontWeight: 'bold',
                      fill: 0xFFFFFF
                  });

                  txt.anchor.set(0.5);
                  txt.x = 180;
                  txt.y = 29;

                  botao.addChild(txt);

                  botao.eventMode = 'static';
                  botao.cursor = 'pointer';

                  botao.hitArea = new PIXI.Rectangle(
                      0, 0, 360, 58
                  );

                  botao.on('pointerover', () => {
                      desenharFundo(0x42799B, 0xB83A46);
                      txt.alpha = 1;
                  });

                  botao.on('pointerout', () => {
                      desenharFundo(cor, 0x536985);
                      txt.alpha = 0.9;
                  });

                  botao.on('pointerdown', () => {
                      desenharFundo(0x263F55, 0xA8323E);
                      botao.scale.set(0.98);
                  });

                  botao.on('pointerup', () => {
                      desenharFundo(0x42799B, 0xB83A46);
                      botao.scale.set(1);
                  });

                  botao.on('pointerupoutside', () => {
                      desenharFundo(cor, 0x536985);
                      botao.scale.set(1);
                  });

                  botao.on('pointertap', acao);

                  this.telaPausa.addChild(botao);
                  return botao;
              };

              this.botaoContinuarPausa = criarBotaoPausa(
                  'CONTINUAR',
                  350,
                  () => this.continuarJogo()
              );

              this.botaoMenuPausa = criarBotaoPausa(
                  'MENU PRINCIPAL',
                  430,
                  () => this.voltarMenuPausa(),
                  0x354154
              );

              this.congelarAnimacoes = () => {
                  this.animacoesPausadas = [];

                  const tipos = ['Jogador', 'Zumbi'];

                  for (const tipo of tipos) {
                      const objetos = templates.list[tipo] || [];

                      for (const objeto of objetos) {
                          if (!templates.valid(objeto)) {
                              continue;
                          }

                          this.animacoesPausadas.push({
                              objeto,
                              velocidade: objeto.animationSpeed
                          });

                          objeto.animationSpeed = 0;
                      }
                  }
              };

              this.restaurarAnimacoes = () => {
                  for (const item of this.animacoesPausadas) {
                      if (templates.valid(item.objeto)) {
                          item.objeto.animationSpeed = item.velocidade;
                      }
                  }

                  this.animacoesPausadas = [];
              };

              this.animarEntradaPausa = () => {
                  const ticker = PIXI.Ticker.shared;

                  if (this.atualizarAnimacaoPausa) {
                      ticker.remove(this.atualizarAnimacaoPausa);
                      this.atualizarAnimacaoPausa = null;
                  }

                  const elementos = [
                      { objeto: this.textoProtocoloPausa, atraso: 2 },
                      { objeto: this.textoTituloPausa, atraso: 3 },
                      { objeto: this.textoDescricaoPausa, atraso: 6 },
                      { objeto: this.botaoContinuarPausa, atraso: 9 },
                      { objeto: this.botaoMenuPausa, atraso: 12 },
                      { objeto: this.textoInstrucaoPausa, atraso: 15 }
                  ];

                  for (const elemento of elementos) {
                      elemento.posicaoOriginal = elemento.objeto.y;
                      elemento.objeto.alpha = 0;
                      elemento.objeto.y = elemento.posicaoOriginal + 15;
                  }

                  this.telaPausa.alpha = 0;
                  this.telaPausa.visible = true;

                  let progresso = 0;

                  this.atualizarAnimacaoPausa = delta => {
                      progresso += delta;

                      this.telaPausa.alpha = Math.min(
                          1,
                          progresso / 15
                      );

                      for (const elemento of elementos) {
                          const tempoElemento = Math.max(
                              0,
                              progresso - elemento.atraso
                          );

                          const intensidade = Math.min(
                              1,
                              tempoElemento / 10
                          );

                          elemento.objeto.alpha = intensidade;

                          elemento.objeto.y =
                              elemento.posicaoOriginal +
                              15 * (1 - intensidade);
                      }

                      if (progresso >= 25) {
                          this.telaPausa.alpha = 1;

                          for (const elemento of elementos) {
                              elemento.objeto.alpha = 1;
                              elemento.objeto.y =
                                  elemento.posicaoOriginal;
                          }

                          ticker.remove(this.atualizarAnimacaoPausa);
                          this.atualizarAnimacaoPausa = null;
                      }
                  };

                  ticker.add(this.atualizarAnimacaoPausa);
              };

              this.animarSaidaPausa = aoFinalizar => {
                  const ticker = PIXI.Ticker.shared;

                  if (this.atualizarAnimacaoPausa) {
                      ticker.remove(this.atualizarAnimacaoPausa);
                      this.atualizarAnimacaoPausa = null;
                  }

                  let progresso = 1;

                  this.atualizarAnimacaoPausa = delta => {
                      progresso -= delta / 15;

                      this.telaPausa.alpha = Math.max(
                          0,
                          progresso
                      );

                      if (progresso <= 0) {
                          ticker.remove(this.atualizarAnimacaoPausa);
                          this.atualizarAnimacaoPausa = null;

                          this.telaPausa.visible = false;
                          this.telaPausa.alpha = 1;

                          aoFinalizar();
                      }
                  };

                  ticker.add(this.atualizarAnimacaoPausa);
              };

              this.pausarJogo = () => {
                  if (
                      rooms.current.paused ||
                      this.transicaoPausaAtiva
                  ) {
                      return;
                  }

                  sounds.pause();
                  this.inicioPausa = Date.now();

                  rooms.current.paused = true;
                  this.congelarAnimacoes();
                  this.animarEntradaPausa();
              };

              this.continuarJogo = () => {
                  if (
                      !rooms.current.paused ||
                      this.transicaoPausaAtiva
                  ) {
                      return;
                  }

                  this.transicaoPausaAtiva = true;

                  this.animarSaidaPausa(() => {
                      sounds.resume();

                      const duracaoPausa =
                          Date.now() - this.inicioPausa;

                      const gerenciadores =
                          templates.list['GerenciadorOndas'] || [];

                      for (const g of gerenciadores) {
                          if (!templates.valid(g)) {
                              continue;
                          }

                          if (g.proximaOndaEm) {
                              g.proximaOndaEm += duracaoPausa;
                          }

                          if (g.inicioOndaEm) {
                              g.inicioOndaEm += duracaoPausa;
                          }
                      }

                      const zumbis = templates.list['Zumbi'] || [];

                      for (const zumbi of zumbis) {
                          if (!templates.valid(zumbi)) {
                              continue;
                          }

                          if (zumbi.ultimoAtaque) {
                              zumbi.ultimoAtaque += duracaoPausa;
                          }

                          if (zumbi.piscarAte) {
                              zumbi.piscarAte += duracaoPausa;
                          }
                      }

                      const jogadores =
                          templates.list['Jogador'] || [];

                      for (const jogador of jogadores) {
                          if (!templates.valid(jogador)) {
                              continue;
                          }

                          if (jogador.piscarAte) {
                              jogador.piscarAte += duracaoPausa;
                          }
                      }

                      this.restaurarAnimacoes();

                      rooms.current.paused = false;
                      this.transicaoPausaAtiva = false;
                  });
              };

              this.alternarPausa = () => {
                  if (this.transicaoPausaAtiva) {
                      return;
                  }

                  if (rooms.current.paused) {
                      this.continuarJogo();
                  } else {
                      this.pausarJogo();
                  }
              };

              this.voltarMenuPausa = () => {
                  if (
                      !rooms.current.paused ||
                      this.transicaoPausaAtiva
                  ) {
                      return;
                  }

                  this.transicaoPausaAtiva = true;

                  this.animarSaidaPausa(() => {
                      this.restaurarAnimacoes();
                      rooms.current.paused = false;

                      sounds.stop();

                      this.transicaoPausaAtiva = false;
                      rooms.switch('rm_menu');
                  });
              };

              this.telaPausa.visible = false;
              this.telaPausa.alpha = 1;

              this.ultimaOndaVinheta = -1;
              this.ultimoNivelVisao = -1;

              this.canvasVinheta = document.createElement('canvas');
              this.canvasVinheta.width = 512;
              this.canvasVinheta.height = 512;

              this.contextoVinheta =
                  this.canvasVinheta.getContext('2d');

              this.texturaVinheta = PIXI.Texture.from(
                  this.canvasVinheta
              );

              this.spriteVinheta = new PIXI.Sprite(
                  this.texturaVinheta
              );

              this.spriteVinheta.anchor.set(0.5);
              this.spriteVinheta.x = 640 - this.x;
              this.spriteVinheta.y = 360 - this.y;
              this.spriteVinheta.width = 2560;
              this.spriteVinheta.height = 2560;
              this.spriteVinheta.eventMode = 'none';

              this.addChildAt(this.spriteVinheta, 0);

              this.atualizarVinheta = (onda, nivelVisao = 0) => {
                  const ctx = this.contextoVinheta;

                  const numeroOnda = Math.max(
                      1,
                      Number(onda) || 1
                  );

                  const bonusVisao = Math.max(
                      0,
                      Number(nivelVisao) || 0
                  );

                  const progresso = Math.min(
                      14,
                      numeroOnda - 1
                  );

                  // Raio do campo de visao em pixels do canvas
                  // (1 px no canvas = 5 px na tela)
                  const raioInterno = Math.min(
                      95,
                      24 + bonusVisao * 10
                  );

                  const raioExterno = Math.min(
                      175,
                      56 + bonusVisao * 18
                  );

                  const borda = Math.max(
                      0.65,
                      Math.min(
                          0.97,
                          0.82 + progresso * 0.012
                      ) - Math.min(0.15, bonusVisao * 0.02)
                  );

                  const medio = borda * 0.55;

                  ctx.clearRect(0, 0, 512, 512);

                  const gradiente = ctx.createRadialGradient(
                      256, 256, raioInterno,
                      256, 256, raioExterno
                  );

                  gradiente.addColorStop(
                      0,
                      'rgba(2, 4, 10, 0)'
                  );

                  gradiente.addColorStop(
                      0.55,
                      `rgba(2, 4, 10, ${medio})`
                  );

                  gradiente.addColorStop(
                      1,
                      `rgba(2, 4, 10, ${borda})`
                  );

                  ctx.fillStyle = gradiente;
                  ctx.fillRect(0, 0, 512, 512);

                  this.texturaVinheta.update();
                  this.ultimaOndaVinheta = numeroOnda;
                  this.ultimoNivelVisao = bonusVisao;
              };

              this.atualizarVinheta(1, 0);

              this.mostrarHitboxes = false;
              this.debugHitboxes = new PIXI.Graphics();
              this.debugHitboxes.eventMode = 'none';

              this.addChild(this.debugHitboxes);

              if (this.telaPausa) {
                  const indicePausa =
                      this.getChildIndex(this.telaPausa);

                  this.setChildIndex(
                      this.debugHitboxes,
                      Math.max(0, indicePausa - 1)
                  );
              }
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1795397614729
        uid: 1bqjJwgwt7pWJ3
        behaviors: []
        extendTypes: ''
        defaultText: 'Score: 0'
        textStyle: -1
      - type: template
        baseClass: Text
        name: GerenciadorOndas
        depth: 0
        texture: -1
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: |

              if (rooms.current.paused) {
                  return;
              }

              const agora = Date.now();

              const jogador = (templates.list['Jogador'] || [])
                  .find(j => templates.valid(j));

              if (!jogador || jogador.vida <= 0) {
                  return;
              }

              const principal = (
                  templates.list['GerenciadorOndas'] || []
              ).find(g => templates.valid(g));

              if (principal !== this) {
                  return;
              }

              const embaralhar = lista => {
                  for (let i = lista.length - 1; i > 0; i--) {
                      const j = Math.floor(Math.random() * (i + 1));
                      [lista[i], lista[j]] = [lista[j], lista[i]];
                  }

                  return lista;
              };

              if (this.estado === 'escolha') {
                  let indice = -1;

                  if (actions.Escolha1?.pressed) {
                      indice = 0;
                  } else if (actions.Escolha2?.pressed) {
                      indice = 1;
                  } else if (actions.Escolha3?.pressed) {
                      indice = 2;
                  }

                  if (actions.PularMelhoria?.pressed) {
                      this.opcoesMelhoria = [];
                      this.estado = 'intervalo';
                      this.proximaOndaEm = agora + this.intervaloOndas;
                      return;
                  }

                  if (indice >= 0 && indice < this.opcoesMelhoria.length) {
                      const melhoria = this.opcoesMelhoria[indice];

                      if (jogador.moedas < melhoria.preco) {
                          return;
                      }

                      switch (melhoria.id) {
                          case 'dano':
                              jogador.dano += 5;
                              break;
                          case 'movimento':
                              jogador.velocidade += 20;
                              break;
                          case 'vida':
                              jogador.vidaMaxima += 20;
                              break;
                          case 'projetil':
                              jogador.velocidadeProjetil += 75;
                              break;

                          case 'visao':
                              jogador.campoVisao =
                                  (jogador.campoVisao || 0) + 1;
                              break;
                      }

                      jogador.moedas -= melhoria.preco;
                      this.opcoesMelhoria = [];
                      this.estado = 'intervalo';
                      this.proximaOndaEm = agora + this.intervaloOndas;
                  }

                  return;
              }

              const zumbisVivos = (templates.list['Zumbi'] || [])
                  .filter(z =>
                      templates.valid(z) &&
                      !z.kill &&
                      !z.morrendo &&
                      z.vida > 0
                  );

              if (
                  this.estado !== 'combate' &&
                  agora >= this.proximaOndaEm
              ) {
                  const proximaOnda = this.onda + 1;

                  const quantidade =
                      this.inimigosPorOnda + (proximaOnda - 1) * 2;

                  const sala = rooms.current;

                  const obstaculos = (
                      templates.list['Obstaculo'] || []
                  ).filter(o => templates.valid(o) && !o.kill);

                  const margem = 36;

                  const areas = obstaculos.map(o => {
                      const b = o.getBounds();

                      const p1 = sala.toLocal(
                          new PIXI.Point(b.x, b.y)
                      );

                      const p2 = sala.toLocal(
                          new PIXI.Point(
                              b.x + b.width,
                              b.y + b.height
                          )
                      );

                      return {
                          esquerda: Math.min(p1.x, p2.x) - margem,
                          direita: Math.max(p1.x, p2.x) + margem,
                          topo: Math.min(p1.y, p2.y) - margem,
                          baixo: Math.max(p1.y, p2.y) + margem
                      };
                  });

                  const foraObstaculos = (x, y) =>
                      !areas.some(a =>
                          x >= a.esquerda &&
                          x <= a.direita &&
                          y >= a.topo &&
                          y <= a.baixo
                      );

                  const tamanhoCelula = 32;
                  const colunas = 40;
                  const linhas = 23;
                  const total = colunas * linhas;

                  const indiceMapa = (x, y) => y * colunas + x;

                  const dentroMapa = (x, y) =>
                      x >= 0 && x < colunas &&
                      y >= 0 && y < linhas;

                  const coordX = x => Math.max(
                      0,
                      Math.min(colunas - 1, Math.floor(x / tamanhoCelula))
                  );

                  const coordY = y => Math.max(
                      0,
                      Math.min(linhas - 1, Math.floor(y / tamanhoCelula))
                  );

                  const livres = new Uint8Array(total);

                  for (let gy = 0; gy < linhas; gy++) {
                      for (let gx = 0; gx < colunas; gx++) {
                          const x = gx * tamanhoCelula + 16;
                          const y = gy * tamanhoCelula + 16;

                          const valido =
                              x >= 52 && x <= 1228 &&
                              y >= 52 && y <= 668 &&
                              foraObstaculos(x, y);

                          livres[indiceMapa(gx, gy)] = valido ? 1 : 0;
                      }
                  }

                  let origem = -1;
                  let menorDistancia = Infinity;

                  for (let gy = 0; gy < linhas; gy++) {
                      for (let gx = 0; gx < colunas; gx++) {
                          const i = indiceMapa(gx, gy);

                          if (!livres[i]) {
                              continue;
                          }

                          const x = gx * tamanhoCelula + 16;
                          const y = gy * tamanhoCelula + 16;

                          const d = Math.hypot(
                              x - jogador.x,
                              y - jogador.y
                          );

                          if (d < menorDistancia) {
                              menorDistancia = d;
                              origem = i;
                          }
                      }
                  }

                  const acessiveis = new Uint8Array(total);

                  if (origem >= 0) {
                      const fila = new Int32Array(total);
                      let inicio = 0;
                      let fim = 0;

                      fila[fim++] = origem;
                      acessiveis[origem] = 1;

                      const direcoes = [
                          [1, 0], [-1, 0],
                          [0, 1], [0, -1]
                      ];

                      while (inicio < fim) {
                          const atual = fila[inicio++];
                          const cx = atual % colunas;
                          const cy = Math.floor(atual / colunas);

                          for (const [dx, dy] of direcoes) {
                              const nx = cx + dx;
                              const ny = cy + dy;

                              if (!dentroMapa(nx, ny)) {
                                  continue;
                              }

                              const ni = indiceMapa(nx, ny);

                              if (!livres[ni] || acessiveis[ni]) {
                                  continue;
                              }

                              acessiveis[ni] = 1;
                              fila[fim++] = ni;
                          }
                      }
                  }

                  const posicoesEscolhidas = [];

                  const distanciaMinimaJogador = 170;
                  const distanciaMinimaZumbis = 55;

                  const posicaoLivre = (x, y) => {
                      if (
                          x < 70 || x > 1210 ||
                          y < 70 || y > 650
                      ) {
                          return false;
                      }

                      if (!foraObstaculos(x, y)) {
                          return false;
                      }

                      const i = indiceMapa(coordX(x), coordY(y));

                      if (!livres[i] || !acessiveis[i]) {
                          return false;
                      }

                      if (
                          Math.hypot(
                              x - jogador.x,
                              y - jogador.y
                          ) < distanciaMinimaJogador
                      ) {
                          return false;
                      }

                      for (const p of posicoesEscolhidas) {
                          if (
                              Math.hypot(x - p.x, y - p.y) <
                              distanciaMinimaZumbis
                          ) {
                              return false;
                          }
                      }

                      const existentes = templates.list['Zumbi'] || [];

                      for (const outro of existentes) {
                          if (
                              !templates.valid(outro) ||
                              outro.kill ||
                              outro.morrendo ||
                              outro.vida <= 0
                          ) {
                              continue;
                          }

                          if (
                              Math.hypot(
                                  x - outro.x,
                                  y - outro.y
                              ) < distanciaMinimaZumbis
                          ) {
                              return false;
                          }
                      }

                      return true;
                  };

                  const zonas = [
                      {
                          nome: 'ESQUERDA',
                          minX: 110, maxX: 420,
                          minY: 410, maxY: 535
                      },
                      {
                          nome: 'CENTRO_ESQUERDA',
                          minX: 390, maxX: 590,
                          minY: 385, maxY: 585
                      },
                      {
                          nome: 'SUPERIOR',
                          minX: 510, maxX: 1010,
                          minY: 305, maxY: 375
                      },
                      {
                          nome: 'INFERIOR',
                          minX: 650, maxX: 1080,
                          minY: 560, maxY: 625
                      },
                      {
                          nome: 'DIREITA',
                          minX: 1020, maxX: 1170,
                          minY: 350, maxY: 570
                      }
                  ];

                  const candidatosPorZona = zonas.map(zona => {
                      const candidatos = [];

                      for (
                          let y = zona.minY;
                          y <= zona.maxY;
                          y += 16
                      ) {
                          for (
                              let x = zona.minX;
                              x <= zona.maxX;
                              x += 16
                          ) {
                              if (posicaoLivre(x, y)) {
                                  candidatos.push({
                                      x,
                                      y,
                                      zona: zona.nome
                                  });
                              }
                          }
                      }

                      embaralhar(candidatos);

                      return {
                          nome: zona.nome,
                          candidatos,
                          indiceAtual: 0,
                          criados: 0
                      };
                  });

                  let criados = 0;

                  const zonasDisponiveis = candidatosPorZona.filter(
                      z => z.candidatos.length > 0
                  );

                  const rotacao = zonasDisponiveis.length
                      ? (proximaOnda - 1) % zonasDisponiveis.length
                      : 0;

                  const ordemZonas = [
                      ...zonasDisponiveis.slice(rotacao),
                      ...zonasDisponiveis.slice(0, rotacao)
                  ];

                  let houveProgresso = true;

                  while (criados < quantidade && houveProgresso) {
                      houveProgresso = false;

                      for (const zona of ordemZonas) {
                          if (criados >= quantidade) {
                              break;
                          }

                          let posicao = null;

                          while (
                              zona.indiceAtual < zona.candidatos.length
                          ) {
                              const candidato =
                                  zona.candidatos[zona.indiceAtual++];

                              if (posicaoLivre(candidato.x, candidato.y)) {
                                  posicao = candidato;
                                  break;
                              }
                          }

                          if (!posicao) {
                              continue;
                          }

                          posicoesEscolhidas.push(posicao);

                          const zumbi = templates.copy(
                              'Zumbi',
                              posicao.x,
                              posicao.y
                          );

                          zumbi.vidaMaxima =
                              40 + (proximaOnda - 1) * 10;

                          zumbi.vida = zumbi.vidaMaxima;

                          zumbi.dano =
                              10 + (proximaOnda - 1) * 2;

                          zumbi.velocidade = Math.min(
                              90 + (proximaOnda - 1) * 3,
                              180
                          );

                          criados++;
                          zona.criados++;
                          houveProgresso = true;
                      }
                  }

                  if (criados === 0) {
                      this.estado = 'intervalo';
                      this.proximaOndaEm = agora + this.intervaloOndas;
                  } else {
                      this.onda = proximaOnda;
                      this.estado = 'combate';
                      this.observouInimigos = true;
                      this.inicioOndaEm = agora;
                  }

                  return;
              }

              if (this.estado === 'combate') {
                  if (zumbisVivos.length > 0) {
                      this.observouInimigos = true;
                  }

                  const tempoMinimo =
                      agora - this.inicioOndaEm >= 300;

                  if (
                      this.observouInimigos &&
                      tempoMinimo &&
                      zumbisVivos.length === 0
                  ) {
                      const moedas = templates.list['Moeda'] || [];

                      for (const moeda of moedas) {
                          if (
                              templates.valid(moeda) &&
                              !moeda.kill &&
                              !moeda.coletada
                          ) {
                              jogador.moedas += moeda.valor;
                              moeda.coletada = true;
                              moeda.kill = true;
                          }
                      }

                      const disponiveis = [
                          ...this.melhoriasDisponiveis
                      ];

                      embaralhar(disponiveis);

                      this.opcoesMelhoria = disponiveis.slice(0, 3);
                      this.estado = 'escolha';
                  }
              }
            arguments: {}
          - eventKey: OnCreate
            code: |

              this.onda = 0;
              this.inimigosPorOnda = 3;
              this.intervaloOndas = 3000;

              this.estado = 'aguardando';
              this.proximaOndaEm = Date.now() + 1000;

              this.observouInimigos = false;
              this.inicioOndaEm = 0;

              this.melhoriasDisponiveis = [
                  {
                      id: 'dano',
                      nome: 'DANO +5',
                      preco: 15
                  },
                  {
                      id: 'movimento',
                      nome: 'VELOCIDADE +20',
                      preco: 10
                  },
                  {
                      id: 'vida',
                      nome: 'VIDA MAXIMA +20',
                      preco: 20
                  },
                  {
                      id: 'projetil',
                      nome: 'VELOCIDADE DE PROJETIL +75',
                      preco: 15
                  },
                  {
                      id: 'visao',
                      nome: 'CAMPO DE VISAO +1',
                      preco: 15
                  }
              ];

              this.opcoesMelhoria = [];
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1795397587212
        uid: j1P8f6c1cnnn97
        behaviors: []
        extendTypes: ''
        defaultText: ''
        textStyle: -1
